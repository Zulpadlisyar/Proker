# Caching & Security Headers for Cloudflare Workers Static Assets

# 1. Long-term immutable caching for static media (Images & Fonts)
/images/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Favicons & SEO Root Assets (Essential for Googlebot-Favicons & Crawler caching)
/favicon.ico
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/favicon*.png
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
  Access-Control-Allow-Origin: *

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# 2. Versioned Stylesheets and JavaScript Bundles
/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  X-Content-Type-Options: nosniff

# 3. Security Baseline for all pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# 4. Strict Non-Cacheable Header for Admin CMS Portal
/admin.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
